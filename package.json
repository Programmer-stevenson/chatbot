{
  "name": "saia-dental-assistant",
  "version": "1.0.0",
  "description": "AI-powered dental assistant chatbot using Google Gemini",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "vercel-build": "echo 'Build complete'"
  },
  "keywords": [
    "dental",
    "chatbot",
    "ai",
    "gemini",
    "assistant"
  ],
  "author": "Plexura",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.22.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "server.js",
      "dental-training.js"
    ]
  }
}
