{
  "name": "saia-dental-assistant",
  "version": "2.0.0",
  "description": "AI-powered dental assistant with appointment booking and automated notifications",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "vercel-build": "echo 'Build complete'",
    "test-reminder": "node scripts/test-reminder.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "dental",
    "chatbot",
    "ai",
    "gemini",
    "assistant",
    "appointments",
    "healthcare"
  ],
  "author": "Plexura",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.22.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "mongoose": "^8.19.1",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "optionalDependencies": {
    "@sendgrid/mail": "^8.1.6",
    "nodemailer": "^7.0.9",
    "twilio": "^4.19.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "server.js",
      "dental-training.js",
      "database.js",
      "routes/**/*.js",
      "services/**/*.js"
    ]
  }
}
