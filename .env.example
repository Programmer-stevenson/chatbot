# Server Configuration
NODE_ENV=development
PORT=3000

# Google Gemini AI API Key
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=AIzaSyA5QU_FRr3tliXfHV798PfI1NSi2tXMHAw

# MongoDB Configuration
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/saia-dental

# Or MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/saia-dental?retryWrites=true&w=majority

# Session Configuration
